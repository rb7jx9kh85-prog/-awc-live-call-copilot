# --- Supabase (valeurs publiques, exposées au navigateur) ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_publiable

# --- OpenAI (SECRET — serveur uniquement, jamais NEXT_PUBLIC) -----------------
